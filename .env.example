# Copy to .env and fill in. Never commit .env.

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-haiku-4-5

# Local origins
APP_ORIGIN=http://127.0.0.1:5173
API_ORIGIN=http://127.0.0.1:8787

# Google OAuth (Drive read-only) — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/api/oauth/google/callback

# Shopify Admin API — custom app on a development store
# Required scopes: read_products, write_products, read_themes, write_themes,
# read_content, write_content, read_online_store_navigation
SHOPIFY_STORE_DOMAIN=your-dev-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_your-token-here
SHOPIFY_API_VERSION=2026-01
# Optional: storefront password if the dev store is password-protected
SHOPIFY_STOREFRONT_PASSWORD=
